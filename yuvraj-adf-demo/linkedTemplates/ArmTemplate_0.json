							"body": {
								"value": "@variables('logic_apps_body')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "prepare logic app email body",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "prepare_email_body",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "prepare_email_subject",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "logic_apps_body",
							"value": {
								"value": "{\n\"recipient_email\" : \"@{pipeline().parameters.recipient_email}\",\n\"subject\" : \"@{variables('email_subject')}\",\n\"body\" : \"@{variables('email_body')}\"\n}\n",
								"type": "Expression"
							}
						}
					},
					{
						"name": "prepare_email_subject",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email_subject",
							"value": {
								"value": "@{pipeline().parameters.table_name} - @{pipeline().parameters.status}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "prepare_email_body",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email_body",
							"value": {
								"value": "The table @{pipeline().parameters.table_name} ingestion has been completed, and the status is @{pipeline().parameters.status}.\n\nThanks",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_name": {
						"type": "string"
					},
					"recipient_email": {
						"type": "string"
					},
					"status": {
						"type": "string"
					}
				},
				"variables": {
					"logic_apps_body": {
						"type": "String"
					},
					"email_subject": {
						"type": "String"
					},
					"email_body": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-28T18:53:12Z"
			},
			"dependsOn": []
