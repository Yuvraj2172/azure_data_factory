{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "yuvraj-adf-demo"
		},
		"LS_SQL_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_DB'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://demostorageaccount212.dfs.core.windows.net/"
		},
		"LS_SQL_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "de-sql-server21.database.windows.net"
		},
		"LS_SQL_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "de_database"
		},
		"LS_SQL_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "yuvraj"
		},
		"AZR_EVENT_SIMPLE_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/56f3566d-ee0a-4aca-bb49-82d56702a17b/resourceGroups/yuvraj-data-engineering/providers/Microsoft.Storage/storageAccounts/demostorageaccount212"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "yuvraj-adf-demo_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQL_DB_password": {
						"value": "[parameters('LS_SQL_DB_password')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_SQL_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_DB_properties_typeProperties_server')]"
					},
					"LS_SQL_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_DB_properties_typeProperties_database')]"
					},
					"LS_SQL_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_DB_properties_typeProperties_userName')]"
					},
					"AZR_EVENT_SIMPLE_properties_typeProperties_scope": {
						"value": "[parameters('AZR_EVENT_SIMPLE_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}