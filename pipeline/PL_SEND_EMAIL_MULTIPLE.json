{
	"name": "PL_SEND_EMAIL_MULTIPLE",
	"properties": {
		"activities": [
			{
				"name": "Send_Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "prepare logic app email body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-13.centralindia.logic.azure.com:443/workflows/0915ef71ce5c445ebafce5809007bc4e/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=bYn1_zH35HGDm1sMy_RGaVIHJ-_3JxTdzy4-bc6-erE",
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare logic app email body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare_email_body",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare_email_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"recipient_email\" : \"@{pipeline().parameters.recipient_email}\",\n\"subject\" : \"@{variables('email_subject')}\",\n\"body\" : \"@{replace(variables('email_body'), '\\\"', '''')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "Ingestion Completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "Ingestion Process has been completed for all tables, and below is the status:<br>@{join(pipeline().parameters.table_status, '<br>')}<br><br>Pipeline run ID = @{pipeline().parameters.for_each_run_id}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"recipient_email": {
				"type": "string"
			},
			"table_status": {
				"type": "array"
			},
			"for_each_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"logic_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-31T20:42:55Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}